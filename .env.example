# Образец. Не вводите настоящие секреты в этот файл и не публикуйте свой .env.
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
ALICE_WEBHOOK_TOKEN=REPLACE_WITH_RANDOM_SECRET_32_PLUS_CHARACTERS
ALICE_SKILL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Необязательно: нужно только для ключа, не привязанного к workspace.
ANTHROPIC_WORKSPACE_ID=
# Только для варианта Docker + Caddy:
DOMAIN=voice.example.com

